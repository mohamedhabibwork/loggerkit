    "datadog",
    "elasticsearch",
    "elk",
    "elysia",
    "express",
    "fastify",
    "gelf",
    "graylog",
    "hono",
    "log",
    "logger",
    "logging",
    "logstash",
    "loki",
    "nestjs",
    "opensearch",
    "opentelemetry",
    "otlp",
    "pino",
    "redaction",
    "splunk",
    "structured-logging",
    "syslog",
    "typescript",
    "winston"
  ],
  "homepage": "https://github.com/mohamedhabibwork/loggerkit#readme",
  "bugs": {
